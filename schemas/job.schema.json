{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job state (jobs/<id>/state.json), written only by engine/labcore.py",
  "type": "object",
  "required": ["job_id", "type", "goal", "route", "state", "stage", "stage_kind", "stage_index", "review_index", "fanout", "fixing", "artifact_path", "counters", "created", "updated"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^\\d{8}-[a-z]+-[a-z0-9-]+$"},
    "type": {"type": "string", "pattern": "^[a-z]+$"},
    "goal": {"type": "string"},
    "parent": {"type": ["string", "null"]},
    "route": {"type": "object"},
    "state": {"enum": ["NEW", "PLANNED", "WORKING", "REVIEW", "VERIFY", "REVISING", "GATE", "APPROVED", "DELIVERING", "DONE", "BLOCKED", "ESCALATED", "CANCELLED"]},
    "stage": {"type": ["string", "null"], "description": "agent or script currently responsible"},
    "stage_kind": {"enum": ["agent", "script", "fanout", "fix", "review", "revise", "deliver", null]},
    "stage_index": {"type": "integer"},
    "review_index": {"type": "integer"},
    "fanout": {
      "type": ["object", "null"],
      "properties": {
        "agent": {"type": "string"},
        "split_by": {"type": "string"},
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["status", "calls"],
            "properties": {
              "status": {"enum": ["pending", "running", "done", "failed"]},
              "calls": {"type": "integer"},
              "note": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "fixing": {"type": "boolean"},
    "artifact_path": {"type": ["string", "null"]},
    "resume_to": {"type": ["string", "null"]},
    "last_failed_by": {"type": ["string", "null"]},
    "counters": {
      "type": "object",
      "required": ["critic_revisions", "verifier_revisions", "total_revisions", "fix_attempts", "infra_errors", "gate_rejections", "agent_calls"],
      "additionalProperties": {"type": "integer"}
    },
    "created": {"type": "string"},
    "updated": {"type": "string"}
  }
}
