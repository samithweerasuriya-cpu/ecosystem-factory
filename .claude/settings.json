{
  "permissions": {
    "defaultMode": "default",
    "additionalDirectories": ["C:\\ecosystems"],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git log --oneline -1)",
      "Bash(git log --oneline -5)",
      "Bash(git log --oneline -10)",
      "PowerShell(git status)",
      "PowerShell(git status --short)",
      "PowerShell(git diff)",
      "PowerShell(git diff --stat)",
      "PowerShell(git diff --cached)",
      "PowerShell(git diff --cached --stat)",
      "PowerShell(git log --oneline -1)",
      "PowerShell(git log --oneline -5)",
      "PowerShell(git log --oneline -10)",
      "PowerShell(.venv\\Scripts\\python.exe engine\\run_tests.py --fast)",
      "PowerShell(.venv\\Scripts\\python.exe -m unittest tests.test_cases_t25)",
      "PowerShell(.venv\\Scripts\\python.exe evals\\run_evals.py spend)",
      "Edit(/docs/**)",
      "Write(/docs/**)",
      "Edit(/private/plan/build-log.md)",
      "Write(/private/plan/build-log.md)",
      "Edit(/private/plan/t25-*.md)",
      "Write(/private/plan/t25-*.md)",
      "Edit(/evals/*/cases/**)",
      "Write(/evals/*/cases/**)"
    ],
    "deny": [
      "Bash(python engine/gate.py *)",
      "Bash(python3 engine/gate.py *)",
      "Bash(py -3 engine/gate.py *)",
      "Bash(.venv/Scripts/python.exe engine/gate.py *)",
      "PowerShell(python engine/gate.py *)",
      "PowerShell(python3 engine/gate.py *)",
      "PowerShell(py -3 engine/gate.py *)",
      "PowerShell(.venv\\Scripts\\python.exe engine\\gate.py *)",
      "Agent(interviewer)",
      "Task(interviewer)",
      "Agent(charter-writer)",
      "Task(charter-writer)",
      "Agent(charter-critic)",
      "Task(charter-critic)",
      "Agent(charter-verifier)",
      "Task(charter-verifier)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./**/master.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["-3", "${CLAUDE_PROJECT_DIR}/engine/hooks/pre_tool_use_launcher.py"],
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["-3", "${CLAUDE_PROJECT_DIR}/engine/hooks/post_tool_use_launcher.py"],
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
